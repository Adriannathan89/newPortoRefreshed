---
interface Props {
  name?: string;
}

const { name = "Adrian Nathanael" } = Astro.props;
---

<header data-site-header class="fixed inset-x-4 top-5 z-50 flex justify-center sm:top-6">
  <div
    class="group relative flex max-w-full items-center rounded-[2rem] isolate border border-[#a8bdf5]/50 bg-transparent backdrop-blur-md [[data-light]_&]:border-ink/20 [[data-light]_&]:bg-white/40
    text-mist [[data-light]_&]:text-ink shadow-[0_8px_32px_rgba(12,19,85,0.3),inset_0_1px_2px_rgba(220,230,255,0.55),inset_0_-1px_3px_rgba(114,146,225,0.3)]
    transition-[width,background-color,box-shadow] duration-500 ease-out
    hover:shadow-[0_12px_40px_rgba(12,19,85,0.35),inset_0_1px_2px_rgba(220,230,255,0.65),inset_0_-1px_3px_rgba(114,146,225,0.4)]"
  >
    <button
      type="button"
      aria-expanded="false"
      aria-controls="header-navigation"
      class="relative z-10 flex min-h-14 shrink-0 cursor-pointer items-center justify-center gap-2.5 rounded-full px-7
        text-lg font-bold tracking-tight outline-offset-4 focus-visible:outline-2 focus-visible:outline-ink transition-colors hover:text-mist/90 [[data-light]_&]:hover:text-ink/80"
      aria-label={`Buka navigasi ${name}`}
    >
      <span>
        {name}
        <span class="text-silver/80 [[data-light]_&]:text-ink/50">.</span>
      </span>
      <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" class="size-4 md:hidden"><path d="M4 8h16M4 16h16" /></svg>
    </button>

    <div
      id="header-navigation"
      data-lenis-prevent
      aria-label="Navigasi utama"
      class="header-navigation invisible absolute top-[calc(100%+0.5rem)] left-1/2 z-10 w-[min(90vw,24rem)] -translate-x-1/2 overflow-hidden rounded-2xl border border-white/25 bg-[#211921]/90 p-2 opacity-0 shadow-xl backdrop-blur-xl transition-[width,opacity] duration-500 group-data-[open]:visible group-data-[open]:opacity-100 group-data-[contact-active]:visible group-data-[contact-active]:opacity-100 motion-reduce:transition-none md:relative md:top-auto md:left-auto md:min-w-0 md:w-0 md:translate-x-0 md:overflow-x-auto md:overflow-y-hidden md:rounded-none md:border-0 md:bg-transparent md:p-0 md:shadow-none md:backdrop-blur-none md:[scrollbar-width:none] md:[&::-webkit-scrollbar]:hidden md:group-hover:visible md:group-hover:w-[600px] md:group-hover:opacity-100 md:group-focus-within:visible md:group-focus-within:w-[600px] md:group-focus-within:opacity-100 md:group-data-[open]:w-[600px] md:group-data-[contact-active]:w-[600px]"
    >
      <div class="flex w-full flex-col items-stretch gap-1 md:w-[600px] md:flex-row md:items-center md:justify-between md:gap-0 md:pl-4 md:pr-3">
        <nav class="grid grid-cols-2 gap-1 md:flex md:items-center">
          <a
            href="#main"
            class="rounded-full px-3 py-2 text-sm font-medium whitespace-nowrap text-mist/90 [[data-light]_&]:text-ink/80 transition-colors hover:bg-white/20 hover:text-mist [[data-light]_&]:hover:text-ink
              focus-visible:outline-2 focus-visible:outline-ink"
          >
            Home
          </a>
          <a href="#exploring" class="rounded-full px-3 py-2 text-sm font-medium whitespace-nowrap text-mist/90 [[data-light]_&]:text-ink/80 transition-colors hover:bg-white/20 hover:text-mist [[data-light]_&]:hover:text-ink focus-visible:outline-2 focus-visible:outline-ink">Explore</a>
          <a href="#experience" class="rounded-full px-3 py-2 text-sm font-medium whitespace-nowrap text-mist/90 [[data-light]_&]:text-ink/80 transition-colors hover:bg-white/20 hover:text-mist [[data-light]_&]:hover:text-ink focus-visible:outline-2 focus-visible:outline-ink">Experience</a>
          <a
            href="#projects"
            class="rounded-full px-3 py-2 text-sm font-medium whitespace-nowrap text-mist/90 [[data-light]_&]:text-ink/80 transition-colors
              hover:bg-white/20 hover:text-mist [[data-light]_&]:hover:text-ink focus-visible:outline-2 focus-visible:outline-ink"
          >
            Projects
          </a>
          <a href="#awards" class="rounded-full px-3 py-2 text-sm font-medium whitespace-nowrap text-mist/90 [[data-light]_&]:text-ink/80 transition-colors hover:bg-white/20 hover:text-mist [[data-light]_&]:hover:text-ink focus-visible:outline-2 focus-visible:outline-ink">Awards</a>
        </nav>
        <div class="flex items-center gap-2 border-t border-white/15 pt-1 md:border-0 md:px-2 md:pt-0">
          <button type="button" data-contact-toggle aria-expanded="false" aria-controls="contact-links" aria-haspopup="true" class="flex items-center gap-2 rounded-full px-3 py-2 text-sm font-medium whitespace-nowrap text-mist/90 [[data-light]_&]:text-ink/80 transition-colors hover:bg-white/20 hover:text-mist [[data-light]_&]:hover:text-ink focus-visible:outline-2 focus-visible:outline-ink">
            Contact <span aria-hidden="true">⌄</span>
          </button>
        </div>
      </div>
    </div>
  </div>
  <div id="contact-links" data-contact-menu hidden class="absolute top-full z-50 w-52 pt-2">
    <div class="rounded-2xl border border-white/30 bg-[#34232c]/55 p-2 text-white shadow-[0_14px_35px_rgba(0,0,0,0.25),inset_0_1px_1px_rgba(255,255,255,0.3)] backdrop-blur-2xl backdrop-saturate-150">
      <a href="https://github.com/Adriannathan89" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between rounded-xl px-4 py-3 text-sm transition-colors hover:bg-white/15 focus-visible:outline-2 focus-visible:outline-white">GitHub <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5 fill-current"><path d="M12 .7a11.3 11.3 0 0 0-3.57 22.02c.57.1.77-.25.77-.55v-2.1c-3.15.68-3.81-1.33-3.81-1.33-.51-1.31-1.25-1.66-1.25-1.66-1.03-.7.08-.69.08-.69 1.14.08 1.74 1.17 1.74 1.17 1.01 1.73 2.65 1.23 3.3.94.1-.73.4-1.23.72-1.51-2.51-.29-5.16-1.26-5.16-5.59 0-1.24.44-2.25 1.16-3.04-.12-.28-.5-1.44.11-3 0 0 .95-.3 3.11 1.16a10.8 10.8 0 0 1 5.66 0c2.16-1.46 3.11-1.16 3.11-1.16.61 1.56.23 2.72.11 3 .72.79 1.16 1.8 1.16 3.04 0 4.34-2.65 5.3-5.18 5.58.41.36.77 1.04.77 2.1v3.09c0 .3.2.66.78.55A11.3 11.3 0 0 0 12 .7Z"/></svg></a>
      <a href="https://www.linkedin.com/in/adrian-nathanael-setiawan-809761246/" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between rounded-xl px-4 py-3 text-sm transition-colors hover:bg-white/15 focus-visible:outline-2 focus-visible:outline-white">LinkedIn <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5 fill-current"><path d="M20.45 2H3.55C2.69 2 2 2.68 2 3.52v16.96c0 .84.69 1.52 1.55 1.52h16.9c.86 0 1.55-.68 1.55-1.52V3.52C22 2.68 21.31 2 20.45 2ZM7.93 18.75H4.98V9.2h2.95v9.55ZM6.45 7.9a1.71 1.71 0 1 1 0-3.42 1.71 1.71 0 0 1 0 3.42Zm12.3 10.85h-2.94V14.1c0-1.11-.02-2.54-1.56-2.54-1.56 0-1.8 1.21-1.8 2.46v4.73H9.5V9.2h2.83v1.3h.04c.39-.74 1.36-1.53 2.82-1.53 3.01 0 3.56 1.98 3.56 4.55v5.23Z"/></svg></a>
      <a href="mailto:adrianpersonal677@gmail.com" class="flex items-center justify-between rounded-xl px-4 py-3 text-sm transition-colors hover:bg-white/15 focus-visible:outline-2 focus-visible:outline-white">Email <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="size-5"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg></a>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-site-header]");
  const lightSections = document.querySelectorAll<HTMLElement>("[data-header-light]");
  let pending = false;
  const updateHeader = () => {
    pending = false;
    if (!header) return;
    const headerCenter = header.getBoundingClientRect().top + header.offsetHeight / 2;
    const isLight = Array.from(lightSections).some((section) => {
      const bounds = section.getBoundingClientRect();
      return bounds.top <= headerCenter && bounds.bottom > headerCenter;
    });
    header.toggleAttribute("data-light", isLight);
  };
  const scheduleUpdate = () => {
    if (!pending) {
      pending = true;
      requestAnimationFrame(updateHeader);
    }
  };
  window.addEventListener("scroll", scheduleUpdate, { passive: true });
  window.addEventListener("resize", scheduleUpdate);
  updateHeader();

  const contactToggle = header?.querySelector<HTMLButtonElement>("[data-contact-toggle]");
  const contactMenu = header?.querySelector<HTMLElement>("[data-contact-menu]");
  const headerPanel = contactToggle?.closest<HTMLElement>(".group");
  let contactTimer: ReturnType<typeof setTimeout> | undefined;
  const setContactOpen = (open: boolean) => {
    if (!header || !contactToggle || !contactMenu) return;
    clearTimeout(contactTimer);
    if (open) {
      const anchor = contactToggle.getBoundingClientRect();
      const bounds = header.getBoundingClientRect();
      contactMenu.style.top = `${anchor.bottom - bounds.top}px`;
      contactMenu.style.left = `${Math.max(0, Math.min(anchor.right - bounds.left - 208, bounds.width - 208))}px`;
    }
    contactMenu.hidden = !open;
    contactToggle.setAttribute("aria-expanded", String(open));
    headerPanel?.toggleAttribute("data-contact-active", open);
  };
  const scheduleContactClose = () => {
    clearTimeout(contactTimer);
    contactTimer = setTimeout(() => {
      if (!contactToggle?.matches(":hover") && !contactMenu?.matches(":hover") && !contactToggle?.matches(":focus-visible") && !contactMenu?.contains(document.activeElement)) setContactOpen(false);
    }, 180);
  };
  contactToggle?.addEventListener("pointerenter", (event) => { if (event.pointerType === "mouse") setContactOpen(true); });
  contactToggle?.addEventListener("pointerleave", scheduleContactClose);
  contactToggle?.addEventListener("focus", () => { if (contactToggle.matches(":focus-visible")) setContactOpen(true); });
  contactToggle?.addEventListener("blur", scheduleContactClose);
  contactToggle?.addEventListener("click", () => setContactOpen(contactMenu?.hasAttribute("hidden") ?? true));
  contactMenu?.addEventListener("pointerenter", () => clearTimeout(contactTimer));
  contactMenu?.addEventListener("pointerleave", scheduleContactClose);
  contactMenu?.addEventListener("focusout", scheduleContactClose);
  document.addEventListener("pointerdown", (event) => { if (header && !header.contains(event.target as Node)) setContactOpen(false); });
  document.addEventListener("keydown", (event) => { if (event.key === "Escape" && contactMenu && !contactMenu.hidden) { contactToggle?.focus(); setContactOpen(false); } });

  const button = document.querySelector<HTMLButtonElement>(
    '[aria-controls="header-navigation"]',
  );
  button?.addEventListener("click", () => {
    const container = button.parentElement;
    if (!container) return;
    const open = container.toggleAttribute("data-open");
    button.setAttribute("aria-expanded", String(open));
    if (!open) setContactOpen(false);
  });
  header?.querySelector("#header-navigation nav")?.addEventListener("click", (event) => {
    if (window.innerWidth < 768 && (event.target as Element).closest("a")) {
      button?.parentElement?.removeAttribute("data-open");
      button?.setAttribute("aria-expanded", "false");
      setContactOpen(false);
    }
  });
</script>