---
const awards = [
  { title: "OSN Informatika", subtitle: "National Finalist / 2024", description: "National finalist in Informatics at the 2024 National Science Olympiad (OSN).", image: "/OSN.jpeg", alt: "National finalist certificate for the 2024 National Science Olympiad in Informatics" },
  { title: "ANFORCOM", subtitle: "Third Place / 2023", description: "Third place in the Diponegoro Logic Competition at ANFORCOM 2023.", image: "/ANFORCOM.jpeg", alt: "Third place certificate for the 2023 Diponegoro Logic Competition at ANFORCOM" },
  { title: "Schematics", subtitle: "Finalist / 2024", description: "Finalist in the Schematics National Programming Contest Junior 2024.", image: "/Schematic.jpeg", alt: "Finalist certificate for the Schematics National Programming Contest Junior 2024" },
];
---

<section id="awards" aria-labelledby="awards-title" class="awards relative isolate min-h-svh overflow-hidden bg-[#151a2a] text-white">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-20 overflow-hidden">
    {awards.map((award, index) => <img data-award-background={index} src={award.image} alt="" class:list={["absolute inset-0 size-full object-cover transition-opacity duration-700 motion-reduce:transition-none", index === 0 ? "opacity-100" : "opacity-0"]} />)}
  </div>
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-linear-to-r from-[#0c1020]/90 via-[#101627]/65 to-[#101627]/35"></div>

  <div class="flex min-h-svh flex-col justify-between px-6 pt-24 pb-8 sm:px-10 sm:pt-28 lg:px-16 lg:pb-12">
    <div class="grid flex-1 items-end gap-8 pt-12 pb-5 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:gap-12">
      <div class="max-w-xl self-center" aria-live="polite" aria-atomic="true">
        <div class="mb-5 h-px w-8 bg-white/80"></div>
        <p data-award-subtitle class="text-sm text-white/75">{awards[0].subtitle}</p>
        <h3 data-award-title class="mt-4 text-5xl leading-[0.95] font-semibold tracking-[-0.055em] uppercase sm:text-6xl xl:text-7xl">{awards[0].title}</h3>
        <p data-award-description class="mt-6 max-w-md text-sm leading-relaxed text-white/80 sm:text-base">{awards[0].description}</p>
      </div>

      <div class="min-w-0 w-full lg:ml-auto lg:max-w-md xl:max-w-lg">
        <img data-award-display src={awards[0].image} alt={awards[0].alt} class="sr-only" />
        <p class="mt-5 mb-3 text-[10px] font-semibold tracking-[0.18em] uppercase text-white/65">Explore awards</p>
        <div data-award-cards data-lenis-prevent class="flex gap-3 overflow-x-auto pb-3 sm:gap-4" aria-label="Pilih penghargaan">
          {awards.map((award, index) => (
            <button type="button" data-award-card={index} data-title={award.title} data-subtitle={award.subtitle} data-description={award.description} data-image={award.image} data-alt={award.alt} hidden={index === 0} class="group relative h-36 w-28 shrink-0 overflow-hidden rounded-xl bg-slate-700 text-left shadow-lg transition-transform duration-300 hover:-translate-y-1 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white sm:h-52 sm:w-36" aria-label={`Tampilkan ${award.title}`}>
              <img src={award.image} alt="" class="size-full object-cover" />
              <span aria-hidden="true" class="absolute inset-0 bg-linear-to-t from-black/85 via-black/15 to-transparent"></span>
              <span class="absolute inset-x-3 bottom-3"><span class="block text-[10px] text-white/80">{award.subtitle}</span><span class="mt-1 block text-sm font-semibold tracking-tight uppercase">{award.title}</span></span>
            </button>
          ))}
        </div>
        <div class="mt-3 flex items-center gap-3">
      <div class="flex gap-2">
        <button type="button" data-award-prev aria-label="Penghargaan sebelumnya" class="flex size-9 items-center justify-center rounded-full border border-white/40 text-base transition-colors hover:bg-white/20 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">←</button>
        <button type="button" data-award-next aria-label="Penghargaan berikutnya" class="flex size-9 items-center justify-center rounded-full border border-white/40 text-base transition-colors hover:bg-white/20 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">→</button>
      </div>
      <div aria-hidden="true" class="h-px flex-1 bg-white/25"><div data-award-progress class="h-full w-1/3 bg-white transition-[width] duration-500 motion-reduce:transition-none"></div></div>
      <span data-award-count class="min-w-14 text-right text-xs tabular-nums text-white/75">01 / 03</span>
    </div>
      </div>
    </div>


  </div>
</section>

<script>
  import { gsap } from "gsap";

  document.querySelectorAll<HTMLElement>(".awards").forEach((section) => {
    const cards = Array.from(section.querySelectorAll<HTMLButtonElement>("[data-award-card]"));
    const backgrounds = Array.from(section.querySelectorAll<HTMLElement>("[data-award-background]"));
    const container = section.querySelector<HTMLElement>("[data-award-cards]");
    const display = section.querySelector<HTMLImageElement>("[data-award-display]");
    const title = section.querySelector<HTMLElement>("[data-award-title]");
    const subtitle = section.querySelector<HTMLElement>("[data-award-subtitle]");
    const description = section.querySelector<HTMLElement>("[data-award-description]");
    const progress = section.querySelector<HTMLElement>("[data-award-progress]");
    const count = section.querySelector<HTMLElement>("[data-award-count]");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let active = 0;
    let animating = false;

    function select(index: number, moveFocus = false) {
      const next = (index + cards.length) % cards.length;
      if (next === active || animating || !display) return;
      const current = cards[next];
      const source = current.getBoundingClientRect();
      const target = section.getBoundingClientRect();
      if (moveFocus) section.querySelector<HTMLButtonElement>("[data-award-next]")?.focus();

      const finish = () => {
        active = next;
        display.src = current.dataset.image ?? "";
        display.alt = current.dataset.alt ?? "";
        if (title) title.textContent = current.dataset.title ?? "";
        if (subtitle) subtitle.textContent = current.dataset.subtitle ?? "";
        if (description) description.textContent = current.dataset.description ?? "";
        if (progress) progress.style.width = `${((active + 1) / cards.length) * 100}%`;
        if (count) count.textContent = `${String(active + 1).padStart(2, "0")} / ${String(cards.length).padStart(2, "0")}`;
        backgrounds.forEach((background, i) => {
          background.classList.toggle("opacity-100", i === active);
          background.classList.toggle("opacity-0", i !== active);
        });
        cards.forEach((card, i) => { card.hidden = i === active; });
        for (let offset = 1; offset <= cards.length; offset++) container?.append(cards[(active + offset) % cards.length]);
        if (!reducedMotion.matches) {
          gsap.fromTo([subtitle, title, description].filter(Boolean),
            { opacity: 0, y: 24 },
            { opacity: 1, y: 0, duration: 0.65, stagger: 0.1, ease: "power3.out", clearProps: "opacity,transform" });
        }
      };

      if (reducedMotion.matches || source.width === 0 || target.width === 0) { finish(); return; }
      animating = true;
      const flying = document.createElement("div");
      flying.setAttribute("aria-hidden", "true");
      Object.assign(flying.style, { position: "fixed", zIndex: "100", pointerEvents: "none", overflow: "hidden", borderRadius: "12px", left: `${source.left}px`, top: `${source.top}px`, width: `${source.width}px`, height: `${source.height}px` });
      const image = document.createElement("img");
      image.src = current.dataset.image ?? "";
      image.alt = "";
      Object.assign(image.style, { width: "100%", height: "100%", objectFit: "cover" });
      const shade = document.createElement("div");
      Object.assign(shade.style, { position: "absolute", inset: "0", opacity: "0", background: "linear-gradient(to right, rgba(12,16,32,.90), rgba(16,22,39,.65), rgba(16,22,39,.35))" });
      flying.append(image, shade);
      document.body.append(flying);
      gsap.to(shade, { opacity: 1, duration: 0.7, ease: "power2.inOut" });
      gsap.to(flying, {
        left: target.left, top: target.top, width: target.width, height: target.height,
        borderRadius: 0, duration: 0.7, ease: "power3.inOut",
        onComplete: () => {
          finish();
          gsap.to(flying, { opacity: 0, duration: 0.7, ease: "power2.inOut", onComplete: () => { flying.remove(); animating = false; } });
        },
      });
    }

    cards.forEach((card, index) => card.addEventListener("click", () => select(index, true)));
    section.querySelector("[data-award-prev]")?.addEventListener("click", () => select(active - 1));
    section.querySelector("[data-award-next]")?.addEventListener("click", () => select(active + 1));
  });
</script>
