---
import "lenis/dist/lenis.css";
import "../styles/global.css";
import Header from "../component/Header.astro";
import Hero from "../component/Hero.astro";
import Exploring from "../component/Exploring.astro";
import Overview from "../component/Overview.astro";
import Project from "../component/project.astro";
import Awards from "../component/Awards.astro";
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Project Portfolio</title>
  </head>
  <body class="min-h-screen bg-snow bg-(image:--gradient-white-glow) text-mist">
    <Header />
    <main id="main" class="bg-[linear-gradient(135deg,#49302f_0%,#21171d_55%,#120e14_100%)]">
      <div id="intro" class="relative isolate">
        <div aria-hidden="true" class="pointer-events-none sticky top-0 z-0 -mb-[100svh] h-svh overflow-hidden bg-[#271820]">
          <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_75%_22%,rgba(255,195,143,0.65),transparent_36%),radial-gradient(ellipse_at_22%_74%,rgba(144,66,61,0.55),transparent_42%),linear-gradient(160deg,#b17b70_0%,#ae796e_35%,#673c40_67%,#171624_100%)]"></div>
          <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(30,18,25,0.12)_0%,rgba(25,16,24,0.45)_50%,rgba(12,12,20,0.86)_100%)]"></div>
          <div data-portal-frame class="absolute bottom-[-2%] left-1/2 h-[76%] w-[min(62vw,34rem)] -translate-x-1/2 rounded-t-full border-[10px] border-[#d8c1b6] [transform:scale(4)] [transform-origin:center_bottom] shadow-[0_0_0_120vmax_#8c6d67,inset_0_0_24px_rgba(30,20,25,0.3)] sm:border-[14px]"></div>
        </div>
        <div class="morph-panel relative z-10"><Hero /></div>
        <div class="morph-panel relative z-10"><Exploring /></div>
        <div class="morph-panel relative z-10"><Overview /></div>
      </div>
      <div class="morph-panel"><Project /></div>
      <div class="morph-panel"><Awards /></div>
    </main>
  </body>
</html>

<script>
  import Lenis from "lenis";
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const main = document.querySelector<HTMLElement>("#main");
  const panels = gsap.utils.toArray<HTMLElement>(".morph-panel");
  const media = gsap.matchMedia();

  if (main && panels.length > 1) {
    media.add("(prefers-reduced-motion: no-preference)", () => {
      let gestureEnd = 0;
      let gestureDirection = 0;
      let gestureBoundary: number | undefined;
      let lenis: Lenis;
      lenis = new Lenis({
        anchors: true,
        wheelMultiplier: 2.2,
        lerp: 0.12,
        virtualScroll: (data) => {
          if (!(data.event instanceof WheelEvent) || data.event.ctrlKey || Math.abs(data.deltaX) > Math.abs(data.deltaY)) return true;
          if (data.event.composedPath().some((node) => node instanceof HTMLElement && node.hasAttribute("data-lenis-prevent"))) return true;
          const direction = Math.sign(data.deltaY);
          if (!direction) return true;
          const now = performance.now();
          if (now > gestureEnd || direction !== gestureDirection) {
            const position = lenis.targetScroll;
            const boundaries = panels.map((panel) => panel.getBoundingClientRect().top + window.scrollY);
            gestureBoundary = direction > 0
              ? boundaries.find((value) => value > position + 2)
              : boundaries.slice().reverse().find((value) => value < position - 2);
            gestureDirection = direction;
          }
          gestureEnd = now + 200;
          if (gestureBoundary !== undefined) {
            const remaining = gestureBoundary - lenis.targetScroll;
            data.deltaY = direction > 0 ? Math.max(0, Math.min(data.deltaY, remaining)) : Math.min(0, Math.max(data.deltaY, remaining));
            if (data.deltaY === 0 && data.event.cancelable) data.event.preventDefault();
          }
          return true;
        },
      });
      const updateLenis = (time: number) => lenis.raf(time * 1000);
      lenis.on("scroll", ScrollTrigger.update);
      gsap.ticker.add(updateLenis);
      gsap.ticker.lagSmoothing(0);
      const hero = document.querySelector<HTMLElement>('[aria-label="Beranda"]');
      const intro = document.querySelector<HTMLElement>("#intro");
      const portalFrame = document.querySelector<HTMLElement>("[data-portal-frame]");
      const heroCopy = hero?.querySelector<HTMLElement>("[data-hero-copy]");
      if (hero && heroCopy && intro) {
        if (portalFrame) gsap.fromTo(portalFrame, { scale: 4 }, { scale: 1, transformOrigin: "center bottom", ease: "none", scrollTrigger: { trigger: intro, start: "top top", end: "bottom bottom", scrub: true } });
        gsap.to(heroCopy, { y: -65, opacity: 0, ease: "none", scrollTrigger: { trigger: hero, start: "top top", end: "bottom center", scrub: true } });
      }
      gsap.utils.toArray<HTMLElement>("[data-intro-reveal]").forEach((element) => {
        gsap.from(element, { y: 32, opacity: 0, duration: 0.8, ease: "power2.out", scrollTrigger: { trigger: element, start: "top 88%", once: true } });
      });
      panels.forEach((panel, index) => {
        if (index < 3) return;
        const section = panel.querySelector("section");
        if (!section) return;

        gsap.timeline({
          scrollTrigger: {
            trigger: panel,
            start: "top bottom",
            end: "bottom top",
            scrub: true,
            invalidateOnRefresh: true,
          },
          defaults: { ease: "none" },
        })
          .fromTo(section, { scale: 0.97, borderRadius: "1.5rem" }, { scale: 1, borderRadius: "0rem", duration: 1 })
          .to(section, { scale: 0.97, borderRadius: "1.5rem", duration: 1 });
      });

      return () => {
        gsap.ticker.remove(updateLenis);
        lenis.destroy();
        gsap.ticker.lagSmoothing(500, 33);
      };
    });
  }
</script>
